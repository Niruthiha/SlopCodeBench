/* failure sets */
function failSets(t) {
  const out = {};
  for (const C of cells(t)) {
    out[C.k] = {};
    for (const x of C.checkpoints) for (const [g, l] of Object.entries(x.failed_by_group)) for (const n of l) {
      const id = g.replace(/-.*/, "").replace("checkpoint_", "ck") + " · " + n;
      (out[C.k][id] ||= []).push(+x.checkpoint.slice(-1));
    }
  }
  return out;
}

