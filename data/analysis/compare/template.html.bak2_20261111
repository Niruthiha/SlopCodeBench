<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Parnas Pilot Comparison</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout idea: a lab notebook read top-down. Summary first, then the whole-task grid, then checkpoint detail per task, then sources. */
:root {
  --bg: #f7f8f9; --panel: #ffffff; --ink: #14171a; --ink-2: #4c545c; --ink-3: #7a838c;
  --rule: #dfe3e7; --soft: #eef1f4; --accent: #2b4a6b;
  --c1: #2a78d6; --c2: #eb6834; --c3: #1baf7a;
  --fail: #c93a3a; --fail-bg: #fbe9e9; --warn: #a66a00; --warn-bg: #fdf3dc; --ok: #2f7d4f;
  --display: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #131619; --panel: #1b1f23; --ink: #eceff2; --ink-2: #b4bcc4; --ink-3: #87909a;
  --rule: #2e343a; --soft: #23282d; --accent: #9cc0e6;
  --c1: #3987e5; --c2: #d95926; --c3: #199e70;
  --fail: #ec7373; --fail-bg: #3a2022; --warn: #e3b04b; --warn-bg: #3a3020; --ok: #6cc28f; color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #131619; --panel: #1b1f23; --ink: #eceff2; --ink-2: #b4bcc4; --ink-3: #87909a;
  --rule: #2e343a; --soft: #23282d; --accent: #9cc0e6;
  --c1: #3987e5; --c2: #d95926; --c3: #199e70;
  --fail: #ec7373; --fail-bg: #3a2022; --warn: #e3b04b; --warn-bg: #3a3020; --ok: #6cc28f; color-scheme: dark }
* { box-sizing: border-box }
body { background: var(--bg); color: var(--ink); font: 15px/1.55 var(--display); margin: 0 }
.wrap { max-width: 1180px; margin: 0 auto; padding-block: 28px 64px;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  display: grid; gap: 36px }
h1, h2, h3 { text-wrap: balance; margin: 0; line-height: 1.2 }
h1 { font-size: 30px; font-weight: 700; letter-spacing: -.01em }
h2 { font-size: 21px; font-weight: 600; padding-bottom: 8px; border-bottom: 2px solid var(--ink) }
h3 { font-size: 16px; font-weight: 600 }
p { margin: 0; max-width: 72ch }
.lede { color: var(--ink-2); font-size: 16px }
.eyebrow { font: 500 12px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3) }
section { display: grid; gap: 18px; min-width: 0 }
.panel { background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 18px; min-width: 0 }
.grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px }
.grid4 { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px }
@media (max-width: 860px) { .grid3 { grid-template-columns: 1fr } }
.seg { display: inline-flex; border: 1px solid var(--rule); border-radius: 6px; overflow: hidden }
.seg button { font: 500 13px var(--display); padding: 6px 12px; border: 0; background: var(--panel); color: var(--ink); cursor: pointer }
.seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg) }
.ctl { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center }
.paths details { border-bottom: 1px solid var(--rule); padding: 8px 0 }
.paths details summary { font-weight: 600 }
.path .note { grid-column: 2 / -1; font-size: 12px; color: var(--ink-3) }
svg .ln.dash { stroke-dasharray: 7 5 }
svg .ln.under { stroke-width: 6; opacity: .55 }
.mono { font-family: var(--mono); font-size: 13px }
.muted { color: var(--ink-3) }
.small { font-size: 13px }
.num { font-variant-numeric: tabular-nums }
code { font-family: var(--mono); font-size: .9em; background: var(--soft); padding: 1px 5px; border-radius: 4px }

.chip { display: inline-flex; align-items: center; gap: 6px; font: 500 12px/1 var(--mono); padding: 4px 8px; border-radius: 999px; background: var(--soft); color: var(--ink); white-space: nowrap }
.sw { width: 10px; height: 10px; border-radius: 3px; display: inline-block; flex: none }
.sw.c1 { background: var(--c1) } .sw.c2 { background: var(--c2) } .sw.c3 { background: var(--c3) }
.legend { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center }
.flag { display: inline-flex; gap: 6px; align-items: baseline; font-size: 13px; padding: 6px 10px; border-radius: 6px; background: var(--warn-bg); color: var(--ink) }
.flag b { color: var(--warn) }

.caveats { display: grid; gap: 8px; padding: 14px 16px; border-left: 4px solid var(--warn); background: var(--warn-bg); border-radius: 0 8px 8px 0 }
.caveats li { margin: 2px 0 }
.caveats ul { margin: 0; padding-left: 18px }

/* prompts */
.prompt { font: 13px/1.6 var(--mono); background: var(--soft); border-radius: 6px; padding: 12px; white-space: pre-wrap; word-break: break-word }
.prompt .hl { display: block; border-left: 3px solid var(--cc, var(--accent)); padding-left: 8px; margin: 4px 0; background: var(--panel); border-radius: 0 4px 4px 0 }
.prompt .old { display: block; text-decoration: line-through; color: var(--ink-3) }

/* tasks */
.task-card { display: grid; gap: 8px; align-content: start }
.task-card dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; margin: 0; font-size: 13px }
.task-card dt { color: var(--ink-3) } .task-card dd { margin: 0 }
.ck-list { margin: 0; padding-left: 20px; font-size: 13px; color: var(--ink-2) }

/* overview metric grid */
.ov { display: grid; grid-template-columns: 190px repeat(4, minmax(0, 1fr)); border: 1px solid var(--rule); border-radius: 8px; background: var(--panel); overflow: hidden }
.ov > div { padding: 10px 12px; border-top: 1px solid var(--rule); min-width: 0 }
.ov .hd { border-top: 0; background: var(--soft); font-weight: 600; font-size: 14px }
.ov .mlabel { font-weight: 500; font-size: 14px }
.ov .mlabel small { display: block; color: var(--ink-3); font-weight: 400; font-size: 12px; line-height: 1.35 }
.bars { display: grid; gap: 4px }
.bar { display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 6px; font-size: 12px; cursor: default }
.bar .k { font-family: var(--mono); color: var(--ink-3) }
.bar .track { height: 12px; background: transparent; position: relative }
.bar .fill { height: 100%; border-radius: 0 4px 4px 0; min-width: 2px }
.bar .v { font-family: var(--mono); font-variant-numeric: tabular-nums; min-width: 56px; text-align: right; color: var(--ink) }
.bar.best .v { font-weight: 600 }
.fill.c1 { background: var(--c1) } .fill.c2 { background: var(--c2) } .fill.c3 { background: var(--c3) }
@media (max-width: 760px) {
  .ov { grid-template-columns: 1fr }
  .ov .hd:not(:first-child) { display: none }
  .ov .hd:first-child { display: none }
  .ov .cellv::before { content: attr(data-task); display: block; font: 500 11px/1.4 var(--mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 4px }
  .ov .mlabel { background: var(--soft) }
}

/* notes */
.notes { display: grid; gap: 10px }
.note { display: grid; gap: 6px }
.note ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; font-size: 14px }

/* tabs */
.tabs { display: flex; flex-wrap: wrap; gap: 6px }
.tab { font: 500 14px var(--display); padding: 8px 14px; border-radius: 6px; border: 1px solid var(--rule); background: var(--panel); color: var(--ink); cursor: pointer }
.tab[aria-selected="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink) }
.tab:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px }

.charts { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px }
.chart { background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 12px 12px 6px; display: grid; gap: 4px; min-width: 0 }
.chart h4 { margin: 0; font-size: 14px; font-weight: 600 }
.chart .sub { font-size: 12px; color: var(--ink-3) }
.chart svg { width: 100%; height: auto; display: block; overflow: visible }
svg text { font-family: var(--mono); font-size: 10px; fill: var(--ink-3) }
svg .grid { stroke: var(--rule); stroke-width: 1 }
svg .axis { stroke: var(--ink-3); stroke-width: 1 }
svg .ln { fill: none; stroke-width: 2; stroke-linejoin: round }
svg .ln.c1 { stroke: var(--c1) } svg .ln.c2 { stroke: var(--c2) } svg .ln.c3 { stroke: var(--c3) }
svg .dot { stroke: var(--panel); stroke-width: 2 }
svg .dot.c1 { fill: var(--c1) } svg .dot.c2 { fill: var(--c2) } svg .dot.c3 { fill: var(--c3) }
svg .cross { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 3 3 }
svg .lab { font-size: 10px; fill: var(--ink-2) }
svg .resumed { fill: none; stroke: var(--warn); stroke-width: 2 }

.tablewrap { overflow-x: auto; border: 1px solid var(--rule); border-radius: 8px; background: var(--panel) }
table { border-collapse: collapse; width: 100%; font-size: 13px }
th, td { padding: 6px 10px; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--rule); font-variant-numeric: tabular-nums }
th { font-weight: 600; background: var(--soft); position: sticky; top: 0 }
th.grp { text-align: center; border-left: 1px solid var(--rule) }
td.gs, th.gs { border-left: 1px solid var(--rule) }
td:first-child, th:first-child { text-align: left }
tbody tr:hover td { background: var(--soft) }
td.best { font-weight: 700 }
td .bad { color: var(--fail); font-weight: 600 }

/* fail matrix */
.fm td { text-align: center; padding: 4px 6px }
.fm td:first-child { text-align: left; font-family: var(--mono); font-size: 12px; white-space: normal; min-width: 240px; max-width: 420px; word-break: break-all }
.cell-x { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 4px; font: 600 11px var(--mono) }
.cell-x.f { background: var(--fail-bg); color: var(--fail) }
.cell-x.p { color: var(--ink-3); opacity: .45 }
.cell-x.n { color: var(--ink-3); opacity: .25 }

/* tools */
.tools { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px }

/* paths */
.paths { display: grid; gap: 6px }
.path { display: grid; grid-template-columns: 200px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--rule) }
.path span:nth-child(2) { font: 12.5px var(--mono); word-break: break-all; color: var(--ink-2) }
.path button { font: 500 12px var(--display); padding: 4px 10px; border-radius: 5px; border: 1px solid var(--rule); background: var(--panel); color: var(--ink); cursor: pointer }
@media (max-width: 640px) { .path { grid-template-columns: 1fr auto } .path span:first-child { grid-column: 1 / -1; font-weight: 600 } }

#tip { position: fixed; pointer-events: none; z-index: 20; background: var(--ink); color: var(--bg); font: 12px/1.45 var(--mono); padding: 8px 10px; border-radius: 6px; max-width: 320px; opacity: 0; transition: opacity .08s }
@media (prefers-reduced-motion: reduce) { #tip { transition: none } }
details summary { cursor: pointer; font-weight: 500 }
</style>
</head>
<body>
<div id="tip" role="tooltip"></div>
<main class="wrap">

<header style="display:grid;gap:10px">
  <span class="eyebrow">slop-code-bench · Parnas pilot · seed 1 · 2026-11-09 to 11-11</span>
  <h1>Does the design instruction change what the agent builds?</h1>
  <p class="lede">Four long, multi-checkpoint coding tasks, each run once under three prompt conditions. Same model (opus-5.5), same harness, same hidden tests. Each condition adds at most one sentence to the first-checkpoint prompt.</p>
  <div class="legend" id="legendTop"></div>
</header>

<div class="caveats">
  <strong>Read these before comparing</strong>
  <ul>
    <li><b>One run per cell.</b> Every number is a single seed. A gap of a few tests or minutes can be run-to-run noise; nothing here is a measured effect.</li>
    <li><b>Two checkpoints were resumed</b> (ring on the chart point). sith c2 checkpoint 2 hit an expired login. metric_transform_lang c3 checkpoint 5 was restarted. Their time, steps and tokens cover only the valid attempt.</li>
    <li><b>eve_industry agents wrote ~1,100–1,500 lines</b>, well under the 2,000-line target. The reference solution is ~4,500 lines. recli is the only task where every cell went past 3,000 lines (4.4k–7.4k).</li>
    <li><b>Dollar cost is left out on purpose</b> and will be added later. Token counts are shown.</li>
  </ul>
</div>

<section id="conditions">
  <h2>The three conditions</h2>
  <p class="small muted">Each first-checkpoint prompt is the benchmark's default text. c2 and c3 add one sentence each. Every later checkpoint gets the same continuation text in every condition, so the conditions differ only at the start.</p>
  <div class="grid3" id="condCards"></div>
  <div class="panel" style="display:grid;gap:8px">
    <h3>Checkpoints 2 onward: identical for every condition</h3>
    <div class="prompt" id="contPrompt"></div>
  </div>
</section>

<section id="tasks">
  <h2>The four tasks</h2>
  <div class="grid4" id="taskCards"></div>
</section>

<section id="whole">
  <h2>Whole task: all checkpoints combined</h2>
  <p class="small muted">Each row is one measure. Each column is one task, with its own scale starting at zero. Within a cell, bars compare c1, c2 and c3. The bold value is the best of the three: fewer failures, less time, or less code complexity. Hover a bar for the exact value.</p>
  <div class="ov" id="ov"></div>
</section>

<section id="differences">
  <h2>What differs</h2>
  <div class="grid4" id="notes"></div>
</section>

<section id="byck">
  <h2>Checkpoint by checkpoint</h2>
  <div class="tabs" role="tablist" id="tabs"></div>
  <p class="small muted" id="tabNote"></p>
  <div class="ctl"><span class="small muted">Effort and token charts show</span><div class="seg" id="cumSeg"><button type="button" data-cum="0" aria-pressed="true">Per checkpoint</button><button type="button" data-cum="1" aria-pressed="false">Running total</button></div></div>
  <h3>Tests</h3>
  <p class="small muted">Pass rate and failed-test count carry the same information: at each checkpoint, failed = total − passed (minus a few skips), and every condition runs the same tests. Comparing failed tests is easier to read, and the third chart removes the tests that fail in all three conditions, leaving only what separates them.</p>
  <div class="charts" id="chartsTests"></div>
  <h3>Effort</h3>
  <div class="charts" id="chartsEffort"></div>
  <h3>Tokens</h3>
  <p class="small muted">Split by kind. Cache-read is 10–100× larger than the others, so it has its own chart; it grows with steps × context size.</p>
  <div class="charts" id="chartsTok"></div>
  <h3>Code</h3>
  <div class="charts" id="chartsCode"></div>
  <h3>Per-checkpoint table</h3>
  <div class="tablewrap"><table id="cktable"></table></div>
  <h3>Tests that failed in some conditions but not all</h3>
  <p class="small muted" id="fmNote"></p>
  <div class="tablewrap"><table class="fm" id="fm"></table></div>
  <details class="panel"><summary id="allFailSum"></summary><div class="mono small" id="allFailList" style="margin-top:10px;display:grid;gap:2px"></div></details>
  <h3>Tool calls by tool</h3>
  <div class="tools" id="tools"></div>
</section>

<section id="isolation">
  <h2>Isolation and leakage checks</h2>
  <p class="small">Every one of the 12 cells passed <code>check_cell.py</code> at every checkpoint. The checks were:</p>
  <ul class="small" style="margin:0;padding-left:18px;display:grid;gap:3px;max-width:80ch">
    <li>an identical 17-skill list at every checkpoint, with no <code>anthropic-skills</code>, no MCP servers or tools, and 0 Skill or MCP calls;</li>
    <li>0 mentions of <code>.evaluation_tests</code>, <code>scb-problems</code> or <code>solutions/</code> in any agent transcript;</li>
    <li>a fresh container at every checkpoint after the first, with an identical starting listing;</li>
    <li>agent-written docs (.md/.rst) deleted before the next checkpoint;</li>
    <li>0 credential files and 0 token-shaped strings in the run directory;</li>
    <li>the harness verifier (<code>verify_setup.sh</code>) reporting ALL PASS before each cell;</li>
    <li>every transcript fully parsed. In recli c3 checkpoint 8 the log writer dropped a newline at the 4,096-byte mark, so two complete records share one line. The checker now reads both and fails a cell on any unreadable fragment instead of skipping it. All 12 cells re-checked with 0 unreadable fragments.</li>
  </ul>
  <p class="small">The reference solution passes 100% of tests at every checkpoint of all four tasks. For recli, a split copy of the reference (entry file plus a package) also passes 100% at checkpoints 1 and 8, so multi-file solutions are not penalised by how the tests load the program. One exception: metric_transform_lang checkpoint 4 skips 46 checkpoint-1 tests by design, and those count as non-passes for every condition alike.</p>
</section>

<section id="paths">
  <h2>Where the data lives</h2>
  <p class="small muted">Local paths on the experiment machine. Every number on this page comes from <code>analysis/compare/data.json</code>, which <code>extract.py</code> rebuilds from the run directories.</p>
  <div class="panel paths" id="pathList"></div>
</section>

</main>
<script>
const DATA = __DATA__;
const ROOT = "/home/niruthi/features/scbench/";
const TASKS = ["sith", "eve_industry", "recli", "metric_transform_lang"];
const TINFO = {
  sith: { name: "sith", diff: "Hard", what: "Python code-intelligence CLI: parsing, type inference, go-to-definition, cross-file references, refactoring and a REPL mode.", ref: "~5,000", prompt: "current" },
  eve_industry: { name: "eve_industry", diff: "Hard", what: "EVE Online industry planner over a 2.1 MB static-data export: recipes, invention odds, material efficiency, build plans and stock-aware planning.", ref: "~4,500", prompt: "current" },
  recli: { name: "recli", diff: "Hard", what: "Hierarchical command-line tool (appctl): command tree and argument parsing, layered configuration, aliases and global parameters, packages, logging and output formats.", ref: "~3,800", prompt: "current" },
  metric_transform_lang: { name: "metric_transform_lang", diff: "Hard", what: "Small DSL interpreter for sales-event metric pipelines: rollups, typed schemas, multi-feed joins and pause/resume pipelines.", ref: "~5,900", prompt: "current" }
};
const CK = { c1: "c1 Default", c2: "c2 Modular", c3: "c3 Parnas" };
const CKLONG = { c1: "Default (benchmark prompt only)", c2: "Modular: split into well-organised modules", c3: "Parnas: decompose by information hiding" };
const key = c => c.slice(0, 2);
const cells = t => Object.entries(DATA.tasks[t].cells).map(([c, C]) => ({ k: key(c), name: c, ...C }));
const sum = (a, f) => a.reduce((s, x) => s + f(x), 0);
const fmt = (v, d = 0) => v == null ? "—" : Number(v).toLocaleString("en-US", { maximumFractionDigits: d, minimumFractionDigits: d });
const fmtTok = v => v >= 1e6 ? fmt(v / 1e6, 1) + "M" : fmt(v / 1e3, 0) + "k";
const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
const $ = id => document.getElementById(id);

/* tooltip */
const tip = $("tip");
document.addEventListener("mousemove", e => {
  const t = e.target.closest("[data-tip]");
  if (!t) { tip.style.opacity = 0; return; }
  tip.innerHTML = t.dataset.tip; tip.style.opacity = 1;
  const w = tip.offsetWidth, h = tip.offsetHeight;
  tip.style.left = Math.min(e.clientX + 14, innerWidth - w - 8) + "px";
  tip.style.top = (e.clientY + 14 + h > innerHeight ? e.clientY - h - 10 : e.clientY + 14) + "px";
});

$("legendTop").innerHTML = ["c1", "c2", "c3"].map(k => `<span class="chip"><span class="sw ${k}"></span>${CK[k]} · ${CKLONG[k].split(":")[0]}</span>`).join("");

/* conditions */
(() => {
  const cur = TASKS.slice(0, 1).map(t => cells(t))[0];
  $("condCards").innerHTML = cur.map(c => {
    const head = c.checkpoints[0].prompt_head;
    const base = ["Implement a program that 100% solves the specification. That is all you need to do.",
      "Use a virtual environment and ensure that a `requirements.txt` is present with any dependencies you need to solve the problem."];
    const lines = head.map(l => base.includes(l) ? esc(l) : `<span class="hl" style="--cc:var(--${c.k})">${esc(l)}</span>`).join("\n");
    return `<div class="panel" style="display:grid;gap:10px;border-top:4px solid var(--${c.k})">
      <div><span class="eyebrow">${c.k}</span><h3>${CKLONG[c.k]}</h3></div>
      <div class="prompt">${lines}\nYour task is:\n<span class="muted">…the checkpoint 1 specification…</span></div>
      <p class="small muted">${c.k === "c1" ? "Adds nothing. This is the benchmark's own prompt." : "Adds exactly one sentence to the default."}</p>
    </div>`;
  }).join("");
  const ch = cur[0].checkpoints[1];
  $("contPrompt").innerHTML = ch.prompt_head.map(esc).join("\n") + "\nYour task is:\n<span class=\"muted\">…the next checkpoint's specification…</span>";
})();

/* task cards */
$("taskCards").innerHTML = TASKS.map(t => {
  const c = cells(t)[0]; const ti = TINFO[t];
  const tot = c.checkpoints.map(x => x.total_tests);
  return `<div class="panel task-card">
    <span class="eyebrow">${ti.diff} · ${c.checkpoints.length} checkpoints</span>
    <h3 class="mono">${t}</h3>
    <p class="small">${ti.what}</p>
    <dl><dt>Reference size</dt><dd>${ti.ref} lines</dd>
    <dt>Tests per checkpoint</dt><dd class="mono">${tot.join(" · ")}</dd>
    <dt>Reference passes</dt><dd>100% of executed tests</dd></dl>
    <ol class="ck-list">${c.checkpoints.map(x => `<li>${esc(x.task_line.replace(/\*\*/g, "").replace(/`/g, "").slice(0, 110))}${x.task_line.length > 110 ? "…" : ""}</li>`).join("")}</ol>
  </div>`;
}).join("");

/* overview grid */
const METRICS = [
  { id: "final", label: "Tests passed at the last checkpoint", sub: "includes earlier checkpoints' tests rerun as regression", get: C => C.checkpoints.at(-1).passed_tests, fmt: (v, C) => `${v}/${C.checkpoints.at(-1).total_tests}`, better: "hi" },
  { id: "failed", label: "Failed test instances, all checkpoints", sub: "a test failing at 4 checkpoints counts 4 times", get: C => sum(C.checkpoints, x => x.failed.length), better: "lo" },
