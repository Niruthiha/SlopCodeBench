  /* tools */
  const names = ["Bash", "Write", "Edit", "Read"];
  const tt = cs.map(C => { const o = {}; for (const x of C.checkpoints) for (const [k, v] of Object.entries(x.tools)) { const kk = names.includes(k) ? k : "Other"; o[kk] = (o[kk] || 0) + v; } return o; });
