    lineChart({ title: "Mean cyclomatic complexity", sub: "per function, after the checkpoint", task: t, get: x => x.cc_mean, f: v => fmt(v, 1) }),
  ].join("");

  /* table */
  const cs = cells(t); const n = cs[0].checkpoints.length;
  const cols = [
    ["Passed", x => `${x.passed_tests}/${x.total_tests}`, x => x.passed_tests, "hi"],
    ["Failed", x => x.failed.length ? `<span class="bad">${x.failed.length}</span>` : "0", x => x.failed.length, "lo"],
    ["Min", x => fmt(x.duration / 60, 1) + (x.resumed ? "*" : ""), x => x.duration, "lo"],
    ["Steps", x => x.steps, x => x.steps, "lo"],
    ["Tools", x => x.tool_calls, x => x.tool_calls, "lo"],
    ["Out tok", x => fmtTok(x.output), x => x.output, "lo"],
    ["Cache rd", x => fmtTok(x.cache_read), x => x.cache_read, "lo"],
    ["Lines", x => fmt(x.sloc), x => x.sloc, null],
    ["Files", x => x.files, x => x.files, null],
  ];
  let h = `<thead><tr><th rowspan="2">Checkpoint</th>${cols.map((c, i) => `<th class="grp" colspan="3">${c[0]}</th>`).join("")}</tr><tr>${cols.map(() => cs.map((C, j) => `<th class="${j === 0 ? "gs" : ""}"><span class="sw ${C.k}"></span> ${C.k}</th>`).join("")).join("")}</tr></thead><tbody>`;
  for (let i = 0; i < n; i++) {
    h += `<tr><td>ck${i + 1}</td>`;
    for (const [, show, val, better] of cols) {
      const vs = cs.map(C => val(C.checkpoints[i]));
      const b = better === "hi" ? Math.max(...vs) : better === "lo" ? Math.min(...vs) : null;
      const uniq = b != null && vs.filter(v => v === b).length < 3;
      h += cs.map((C, j) => `<td class="${j === 0 ? "gs" : ""}${uniq && vs[j] === b ? " best" : ""}">${show(C.checkpoints[i])}</td>`).join("");
    }
    h += `</tr>`;
  }
  const tot = { checkpoints: null };
  h += `<tr><td><b>Total</b></td>`;
  const totals = [
    C => { const l = C.checkpoints.at(-1); return [`${l.passed_tests}/${l.total_tests}`, l.passed_tests, "hi"]; },
    C => [sum(C.checkpoints, x => x.failed.length), sum(C.checkpoints, x => x.failed.length), "lo"],
    C => [fmt(sum(C.checkpoints, x => x.duration) / 60, 1), sum(C.checkpoints, x => x.duration), "lo"],
    C => [sum(C.checkpoints, x => x.steps), sum(C.checkpoints, x => x.steps), "lo"],
    C => [sum(C.checkpoints, x => x.tool_calls), sum(C.checkpoints, x => x.tool_calls), "lo"],
    C => [fmtTok(sum(C.checkpoints, x => x.output)), sum(C.checkpoints, x => x.output), "lo"],
    C => [fmtTok(sum(C.checkpoints, x => x.cache_read)), sum(C.checkpoints, x => x.cache_read), "lo"],
    C => [fmt(C.checkpoints.at(-1).sloc), 0, null],
    C => [C.checkpoints.at(-1).files, 0, null],
  ];
  for (const f of totals) {
    const r = cs.map(f); const vs = r.map(z => z[1]); const better = r[0][2];
    const b = better === "hi" ? Math.max(...vs) : better === "lo" ? Math.min(...vs) : null;
    const uniq = b != null && vs.filter(v => v === b).length < 3;
    h += r.map((z, j) => `<td class="${j === 0 ? "gs" : ""}${uniq && vs[j] === b ? " best" : ""}"><b>${z[0]}</b></td>`).join("");
  }
  h += `</tr></tbody>`;
  $("cktable").innerHTML = h + `<caption style="caption-side:bottom;text-align:left;padding:8px 10px" class="small muted">Bold = best of the three when they differ. Totals row: passed is the last checkpoint; lines and files are at the end. * = resumed checkpoint (valid attempt only).</caption>`;

  /* fail matrix */
  const fs = failSets(t); const ids = [...new Set(Object.values(fs).flatMap(o => Object.keys(o)))].sort();
  const diff = ids.filter(id => !["c1", "c2", "c3"].every(k => fs[k][id]));
  const same = ids.filter(id => ["c1", "c2", "c3"].every(k => fs[k][id]));
  let m = `<thead><tr><th>Test (checkpoint it belongs to · name)</th>${cs.map((C, j) => `<th class="grp" colspan="${n}"><span class="sw ${C.k}"></span> ${CK[C.k]}</th>`).join("")}</tr><tr><th></th>${cs.map(() => Array.from({ length: n }, (_, i) => `<th style="text-align:center" class="${i === 0 ? "gs" : ""}">${i + 1}</th>`).join("")).join("")}</tr></thead><tbody>`;
