/* line chart */
let CUM = false;
function lineChart({ title, sub, task, get, f = v => fmt(v), pct = false, cum = false, series: given }) {
  const cs = cells(task); const n = cs[0].checkpoints.length;
  if (cum && CUM) { sub = "running total up to each checkpoint"; title += " (running total)"; }
  const W = 340, H = 170, L = 40, R = 14, T = 12, B = 24;
  const series = given || cs.map(C => ({ k: C.k, v: C.checkpoints.map(get), res: C.checkpoints.map(x => x.resumed) }));
  if (cum && CUM) for (const se of series) { let a = 0; se.v = se.v.map(v => a += v); }
  const same = [];
  series.forEach((se, i) => { const j = series.findIndex((o, jj) => jj < i && o.v.every((v, q) => Math.abs(v - se.v[q]) < 1e-9)); se.dup = j >= 0; if (j >= 0) { series[j].under = true; same.push(`${series[j].k} = ${se.k}`); } });
  if (same.length) sub += ` · <b>${same.join(", ")}</b>: identical, drawn dashed on top`;
  const all = series.flatMap(s => s.v);
  let lo = pct ? Math.min(...all) : 0, hi = Math.max(...all);
  if (pct) { lo = Math.max(0, Math.floor((lo - 2) / 5) * 5); hi = 100; }
  if (hi === lo) hi = lo + 1;
  const nice = (() => { const r = (hi - lo) / 4; const p = Math.pow(10, Math.floor(Math.log10(r))); const s = [1, 2, 2.5, 5, 10].map(m => m * p).find(m => m >= r); return s; })();
  if (!pct) hi = Math.ceil(hi / nice) * nice;
  const ticks = []; for (let v = lo; v <= hi + 1e-9; v += nice) ticks.push(v);
  const x = i => L + (n === 1 ? 0 : i * (W - L - R) / (n - 1));
  const y = v => T + (H - T - B) * (1 - (v - lo) / (hi - lo));
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(title)}">`;
  for (const v of ticks) s += `<line class="grid" x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 6}" y="${y(v) + 3}" text-anchor="end">${pct ? fmt(v) + "%" : f(v)}</text>`;
  for (let i = 0; i < n; i++) s += `<text x="${x(i)}" y="${H - 6}" text-anchor="middle">ck${i + 1}</text>`;
  for (const se of series) s += `<polyline class="ln ${se.k}${se.dup ? " dash" : ""}${se.under && !se.dup ? " under" : ""}" points="${se.v.map((v, i) => `${x(i)},${y(v)}`).join(" ")}"/>`;
  for (const se of series) se.v.forEach((v, i) => {
    s += se.dup ? `<circle class="dot ${se.k}" cx="${x(i)}" cy="${y(v)}" r="2.5"/>` : `<circle class="dot ${se.k}" cx="${x(i)}" cy="${y(v)}" r="4.5"/>`;
    if (se.res[i]) s += `<circle class="resumed" cx="${x(i)}" cy="${y(v)}" r="8"/>`;
  });
  for (let i = 0; i < n; i++) {
    const rows = series.map(se => `<span class='sw ${se.k}'></span> ${CK[se.k]}: ${pct ? fmt(se.v[i], 1) + "%" : f(se.v[i])}${se.res[i] ? " (resumed)" : ""}`).join("<br>");
    const w = (W - L - R) / Math.max(1, n - 1);
    s += `<rect x="${x(i) - w / 2}" y="${T}" width="${w}" height="${H - T - B}" fill="transparent" data-tip="<b>Checkpoint ${i + 1}</b><br>${rows}"/>`;
  }
  s += `</svg>`;
  return `<div class="chart"><h4>${title}</h4><div class="sub">${sub}</div>${s}</div>`;
}

function renderTask(t) {
