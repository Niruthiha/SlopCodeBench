      r.push(row(`${C.name}: isolation check`, `${run}/check_cell.txt`));
      r.push(row(`${C.name}: reset logs`, `${P}/parnas_reset_checkpoint_N.json`, "container respawn and doc deletion per checkpoint"));
      for (const l of C.resume_logs || []) r.push(row(`${C.name}: resume log`, ROOT + l));
      if (C.invalid_attempt) r.push(row(`${C.name}: invalid attempt kept`, ROOT + C.invalid_attempt));
    }
    h += `<details><summary class="mono">${t}</summary>${r.join("")}</details>`;
  }
  $("pathList").innerHTML = h;
  $("pathList").addEventListener("click", async e => {
    const b = e.target.closest("button[data-copy]"); if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = "Copied"; }
    catch { const s = b.previousElementSibling; const r = document.createRange(); r.selectNodeContents(s); getSelection().removeAllRanges(); getSelection().addRange(r); b.textContent = "Selected"; }
    setTimeout(() => b.textContent = "Copy", 1500);
  });
})();
</script>
</body>
</html>
