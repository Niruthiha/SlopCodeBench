    "One checkpoint-6 test, <code>test_skip_tty_flag_passed</code>, is skipped rather than failed with the agents' code (c1 at checkpoints 7–8, c2 and c3 at checkpoint 8). The reference never skips it. These count as non-passes in the pass rate but are left out of the failed counts.",
    "82 tests fail in all three at checkpoint 8, and the reference passes them all. Only 7 fail in c1 alone, 3 in c2 alone and 4 in c3 alone. The shared set needs a spec audit.",
    "c3 dipped mid-run: core tests 0/6 at checkpoint 6 and 1/5 at checkpoint 7, then recovered to 5/7 at checkpoint 8.",
    "c2 and c3 used ~25% more steps, ~50% more cache reads and ~1.6× the code (7.2k and 7.4k lines in 57 and 51 files) than c1's single 4.4k-line file.",
  ],
  metric_transform_lang: [
    "All three end at 71/74. c1 and c3 fail the identical 7 instances. c2 adds 2: <code>edge_format_auto_ambiguous</code> at checkpoints 3 and 4.",
    "46 checkpoint-1 tests are skipped by design at checkpoint 4 in every condition. They are excluded from the failed counts here.",
    "c2 and c3 split the code into 27 and 24 files. c1 kept one file, with the highest complexity and erosion.",
  ],
};
$("notes").innerHTML = TASKS.map(t => `<div class="panel note"><h3 class="mono">${t}</h3><ul>${NOTES[t].map(n => `<li>${n}</li>`).join("")}</ul></div>`).join("");

/* line chart */
let CUM = false;
function lineChart({ title, sub, task, get, f = v => fmt(v), pct = false, cum = false, series: given }) {
  const cs = cells(task); const n = cs[0].checkpoints.length;
  if (cum && CUM) { sub = "running total up to each checkpoint"; title += " (running total)"; }
  const W = 340, H = 170, L = 40, R = 14, T = 12, B = 24;
  const series = given || cs.map(C => ({ k: C.k, v: C.checkpoints.map(get), res: C.checkpoints.map(x => x.resumed) }));
  if (cum && CUM) for (const se of series) { let a = 0; se.v = se.v.map(v => a += v); }
  const same = [];
  series.forEach((se, i) => { const j = series.findIndex((o, jj) => jj < i && o.v.every((v, q) => Math.abs(v - se.v[q]) < 1e-9)); se.dup = j >= 0; if (j >= 0) { series[j].under = true; same.push(`${series[j].k} = ${se.k}`); } });
  if (same.length) sub += ` · <b>${same.join(", ")}</b>: identical, drawn dashed on top`;
  const all = series.flatMap(s => s.v);
  let lo = pct ? Math.min(...all) : 0, hi = Math.max(...all);
  if (pct) { lo = Math.max(0, Math.floor((lo - 2) / 5) * 5); hi = 100; }
  if (hi === lo) hi = lo + 1;
  const nice = (() => { const r = (hi - lo) / 4; const p = Math.pow(10, Math.floor(Math.log10(r))); const s = [1, 2, 2.5, 5, 10].map(m => m * p).find(m => m >= r); return s; })();
  if (!pct) hi = Math.ceil(hi / nice) * nice;
  const ticks = []; for (let v = lo; v <= hi + 1e-9; v += nice) ticks.push(v);
  const x = i => L + (n === 1 ? 0 : i * (W - L - R) / (n - 1));
  const y = v => T + (H - T - B) * (1 - (v - lo) / (hi - lo));
  let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(title)}">`;
  for (const v of ticks) s += `<line class="grid" x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 6}" y="${y(v) + 3}" text-anchor="end">${pct ? fmt(v) + "%" : f(v)}</text>`;
  for (let i = 0; i < n; i++) s += `<text x="${x(i)}" y="${H - 6}" text-anchor="middle">ck${i + 1}</text>`;
  for (const se of series) s += `<polyline class="ln ${se.k}${se.dup ? " dash" : ""}${se.under && !se.dup ? " under" : ""}" points="${se.v.map((v, i) => `${x(i)},${y(v)}`).join(" ")}"/>`;
  for (const se of series) se.v.forEach((v, i) => {
    s += se.dup ? `<circle class="dot ${se.k}" cx="${x(i)}" cy="${y(v)}" r="2.5"/>` : `<circle class="dot ${se.k}" cx="${x(i)}" cy="${y(v)}" r="4.5"/>`;
    if (se.res[i]) s += `<circle class="resumed" cx="${x(i)}" cy="${y(v)}" r="8"/>`;
  });
  for (let i = 0; i < n; i++) {
    const rows = series.map(se => `<span class='sw ${se.k}'></span> ${CK[se.k]}: ${pct ? fmt(se.v[i], 1) + "%" : f(se.v[i])}${se.res[i] ? " (resumed)" : ""}`).join("<br>");
    const w = (W - L - R) / Math.max(1, n - 1);
    s += `<rect x="${x(i) - w / 2}" y="${T}" width="${w}" height="${H - T - B}" fill="transparent" data-tip="<b>Checkpoint ${i + 1}</b><br>${rows}"/>`;
  }
  s += `</svg>`;
  return `<div class="chart"><h4>${title}</h4><div class="sub">${sub}</div>${s}</div>`;
}

function renderTask(t) {
  document.querySelectorAll(".tab").forEach(b => b.setAttribute("aria-selected", b.dataset.t === t));
  CUR = t;
  $("tabNote").innerHTML = "Hover any checkpoint column for exact values. A ring marks a resumed checkpoint.";
  const csx = cells(t);
  const sharedAt = csx[0].checkpoints.map((_, i) => { const sets = csx.map(C => new Set(C.checkpoints[i].failed)); return [...sets[0]].filter(z => sets.every(S => S.has(z))).length; });
  const extra = csx.map(C => ({ k: C.k, v: C.checkpoints.map((x, i) => x.failed.length - sharedAt[i]), res: C.checkpoints.map(x => x.resumed) }));
  const tk = v => v >= 1e6 ? fmt(v / 1e6, 1) + "M" : v >= 1e4 ? fmt(v / 1e3, 0) + "k" : v >= 1e3 ? fmt(v / 1e3, 1) + "k" : fmt(v);
  $("chartsTests").innerHTML = [
    lineChart({ title: "Pass rate", sub: "all tests at that checkpoint, incl. regression", task: t, get: x => 100 * x.passed_tests / x.total_tests, pct: true }),
    lineChart({ title: "Failed tests", sub: "at that checkpoint", task: t, get: x => x.failed.length }),
    lineChart({ title: "Failures beyond the shared set", sub: `failed minus tests failing in all three (shared: ${sharedAt.join(", ")})`, task: t, series: extra }),
  ].join("");
  $("chartsEffort").innerHTML = [
    lineChart({ title: "Agent wall time", sub: "minutes per checkpoint", task: t, get: x => x.duration / 60, f: v => fmt(v), cum: true }),
    lineChart({ title: "Agent steps", sub: "model turns per checkpoint", task: t, get: x => x.steps, cum: true }),
    lineChart({ title: "Tool calls", sub: "per checkpoint", task: t, get: x => x.tool_calls, cum: true }),
  ].join("");
  const split = csx.map(C => { const o = {}; for (const k of Object.keys(PRICE)) o[k] = sum(C.checkpoints, x => x[k] * PRICE[k] / 1e6); o.total = Object.values(o).reduce((a, b) => a + b, 0); return { k: C.k, ...o }; });
  const mxs = Math.max(...split.map(z => z.total));
  const KL = { output: "output", cache_write: "cache write", cache_read: "cache read", input: "input" };
  const OP = { output: 1, cache_write: .7, cache_read: .45, input: .25 };
  const splitHtml = `<div class="chart"><h4>Cost split, whole task</h4><div class="sub">bar segments, left to right: output · cache write · cache read · input (darkest to lightest)</div><div class="bars" style="margin-top:8px">${split.map(z => `<div class="bar"><span class="k">${z.k}</span><span class="track" style="display:flex;gap:2px">${["output", "cache_write", "cache_read", "input"].map(k => `<span class="fill ${z.k}" style="display:block;width:${(z[k] / mxs * 100).toFixed(2)}%;opacity:${OP[k]};border-radius:${k === "input" ? "0 4px 4px 0" : "0"}" data-tip="${CK[z.k]}<br>${KL[k]}: ${fmtUsd(z[k])} (${fmt(100 * z[k] / z.total)}%)"></span>`).join("")}</span><span class="v">${fmtUsd(z.total)}</span></div>`).join("")}</div>
    <table style="margin-top:10px;font-size:12px"><thead><tr><th></th><th>output</th><th>cache wr</th><th>cache rd</th><th>input</th></tr></thead><tbody>${split.map(z => `<tr><td><span class="sw ${z.k}"></span> ${z.k}</td>${["output", "cache_write", "cache_read", "input"].map(k => `<td>${fmtUsd(z[k])}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`;
  $("chartsCost").innerHTML = [
    lineChart({ title: "Cost at list price", sub: "USD per checkpoint", task: t, get: usd, f: v => "$" + fmt(v, v < 10 ? 1 : 0), cum: true }),
    splitHtml,
  ].join("");
  $("chartsTok").innerHTML = [
    lineChart({ title: "Output tokens", sub: "per checkpoint", task: t, get: x => x.output, f: tk, cum: true }),
    lineChart({ title: "Uncached input tokens", sub: "per checkpoint", task: t, get: x => x.input, f: tk, cum: true }),
    lineChart({ title: "Cache-write tokens", sub: "per checkpoint", task: t, get: x => x.cache_write, f: tk, cum: true }),
    lineChart({ title: "Cache-read tokens", sub: "per checkpoint; own scale", task: t, get: x => x.cache_read, f: tk, cum: true }),
  ].join("");
  $("chartsCode").innerHTML = [
    lineChart({ title: "Code size", sub: "non-blank source lines after the checkpoint", task: t, get: x => x.sloc }),
    lineChart({ title: "Source files", sub: "after the checkpoint", task: t, get: x => x.files }),
    lineChart({ title: "Mean cyclomatic complexity", sub: "per function, after the checkpoint", task: t, get: x => x.cc_mean, f: v => fmt(v, 1) }),
  ].join("");

  /* table */
  const cs = cells(t); const n = cs[0].checkpoints.length;
  const cols = [
    ["Passed", x => `${x.passed_tests}/${x.total_tests}`, x => x.passed_tests, "hi"],
    ["Failed", x => x.failed.length ? `<span class="bad">${x.failed.length}</span>` : "0", x => x.failed.length, "lo"],
    ["Min", x => fmt(x.duration / 60, 1) + (x.resumed ? "*" : ""), x => x.duration, "lo"],
    ["Steps", x => x.steps, x => x.steps, "lo"],
    ["Tools", x => x.tool_calls, x => x.tool_calls, "lo"],
    ["Cost", x => fmtUsd(usd(x)), x => usd(x), "lo"],
    ["Out tok", x => fmtTok(x.output), x => x.output, "lo"],
    ["Cache rd", x => fmtTok(x.cache_read), x => x.cache_read, "lo"],
    ["Lines", x => fmt(x.sloc), x => x.sloc, null],
    ["Files", x => x.files, x => x.files, null],
  ];
  let h = `<thead><tr><th rowspan="2">Checkpoint</th>${cols.map((c, i) => `<th class="grp" colspan="3">${c[0]}</th>`).join("")}</tr><tr>${cols.map(() => cs.map((C, j) => `<th class="${j === 0 ? "gs" : ""}"><span class="sw ${C.k}"></span> ${C.k}</th>`).join("")).join("")}</tr></thead><tbody>`;
  for (let i = 0; i < n; i++) {
    h += `<tr><td>ck${i + 1}</td>`;
    for (const [, show, val, better] of cols) {
      const vs = cs.map(C => val(C.checkpoints[i]));
      const b = better === "hi" ? Math.max(...vs) : better === "lo" ? Math.min(...vs) : null;
      const uniq = b != null && vs.filter(v => v === b).length < 3;
      h += cs.map((C, j) => `<td class="${j === 0 ? "gs" : ""}${uniq && vs[j] === b ? " best" : ""}">${show(C.checkpoints[i])}</td>`).join("");
    }
    h += `</tr>`;
  }
  const tot = { checkpoints: null };
  h += `<tr><td><b>Total</b></td>`;
  const totals = [
    C => { const l = C.checkpoints.at(-1); return [`${l.passed_tests}/${l.total_tests}`, l.passed_tests, "hi"]; },
    C => [sum(C.checkpoints, x => x.failed.length), sum(C.checkpoints, x => x.failed.length), "lo"],
    C => [fmt(sum(C.checkpoints, x => x.duration) / 60, 1), sum(C.checkpoints, x => x.duration), "lo"],
    C => [sum(C.checkpoints, x => x.steps), sum(C.checkpoints, x => x.steps), "lo"],
    C => [sum(C.checkpoints, x => x.tool_calls), sum(C.checkpoints, x => x.tool_calls), "lo"],
    C => [fmtUsd(sum(C.checkpoints, usd)), sum(C.checkpoints, usd), "lo"],
    C => [fmtTok(sum(C.checkpoints, x => x.output)), sum(C.checkpoints, x => x.output), "lo"],
    C => [fmtTok(sum(C.checkpoints, x => x.cache_read)), sum(C.checkpoints, x => x.cache_read), "lo"],
    C => [fmt(C.checkpoints.at(-1).sloc), 0, null],
    C => [C.checkpoints.at(-1).files, 0, null],
  ];
  for (const f of totals) {
    const r = cs.map(f); const vs = r.map(z => z[1]); const better = r[0][2];
    const b = better === "hi" ? Math.max(...vs) : better === "lo" ? Math.min(...vs) : null;
    const uniq = b != null && vs.filter(v => v === b).length < 3;
    h += r.map((z, j) => `<td class="${j === 0 ? "gs" : ""}${uniq && vs[j] === b ? " best" : ""}"><b>${z[0]}</b></td>`).join("");
  }
  h += `</tr></tbody>`;
  $("cktable").innerHTML = h + `<caption style="caption-side:bottom;text-align:left;padding:8px 10px" class="small muted">Bold = best of the three when they differ. Totals row: passed is the last checkpoint; lines and files are at the end. * = resumed checkpoint (valid attempt only).</caption>`;

  /* fail matrix */
  const fs = failSets(t); const ids = [...new Set(Object.values(fs).flatMap(o => Object.keys(o)))].sort();
  const diff = ids.filter(id => !["c1", "c2", "c3"].every(k => fs[k][id]));
  const same = ids.filter(id => ["c1", "c2", "c3"].every(k => fs[k][id]));
  let m = `<thead><tr><th>Test (checkpoint it belongs to · name)</th>${cs.map((C, j) => `<th class="grp" colspan="${n}"><span class="sw ${C.k}"></span> ${CK[C.k]}</th>`).join("")}</tr><tr><th></th>${cs.map(() => Array.from({ length: n }, (_, i) => `<th style="text-align:center" class="${i === 0 ? "gs" : ""}">${i + 1}</th>`).join("")).join("")}</tr></thead><tbody>`;
  for (const id of diff) {
    const origin = +id.match(/^ck(\d)/)[1];
    m += `<tr><td>${esc(id)}</td>` + cs.map(C => Array.from({ length: n }, (_, i) => {
      const ck = i + 1; const f = (fs[C.k][id] || []).includes(ck);
      const cls = ck < origin ? "n" : f ? "f" : "p";
      const tipT = ck < origin ? "not yet tested" : f ? "FAILED" : "passed";
      return `<td class="${i === 0 ? "gs" : ""}"><span class="cell-x ${cls}" data-tip="${CK[C.k]}, checkpoint ${ck}: ${tipT}">${cls === "f" ? "✕" : cls === "p" ? "✓" : "·"}</span></td>`;
    }).join("")).join("") + `</tr>`;
  }
  if (!diff.length) m += `<tr><td colspan="${1 + 3 * n}">No differences.</td></tr>`;
  $("fm").innerHTML = m + "</tbody>";
  $("fmNote").innerHTML = `✕ failed · ✓ passed · · not yet tested (the test belongs to a later checkpoint). A test keeps being rerun as a regression at every later checkpoint, so one early bug shows up as a row of ✕.`;
  const inst = sum(same, id => Math.min(...["c1", "c2", "c3"].map(k => fs[k][id].length)));
  $("allFailSum").textContent = `${same.length} tests fail in all three conditions (${inst} test instances). The reference passes all of them. They have not yet been checked against the spec.`;
  $("allFailList").innerHTML = same.map(id => `<div>${esc(id)} <span class="muted">ck ${fs.c1[id].join(",")}</span></div>`).join("");

  /* tools */
  const names = ["Bash", "Write", "Edit", "Read"];
  const tt = cs.map(C => { const o = {}; for (const x of C.checkpoints) for (const [k, v] of Object.entries(x.tools)) { const kk = names.includes(k) ? k : "Other"; o[kk] = (o[kk] || 0) + v; } return o; });
  $("tools").innerHTML = [...names, "Other"].map(nm => {
    const vs = tt.map(o => o[nm] || 0); const mx = Math.max(...vs, 1);
    return `<div class="chart"><h4>${nm}</h4><div class="bars">${cs.map((C, j) => `<div class="bar" data-tip="${CK[C.k]}: ${vs[j]} ${nm} calls"><span class="k">${C.k}</span><span class="track"><span class="fill ${C.k}" style="display:block;width:${(vs[j] / mx * 100).toFixed(1)}%"></span></span><span class="v">${vs[j]}</span></div>`).join("")}</div></div>`;
  }).join("");
}
$("tabs").innerHTML = TASKS.map(t => `<button class="tab" role="tab" data-t="${t}">${t}</button>`).join("");
$("tabs").addEventListener("click", e => { const b = e.target.closest(".tab"); if (b) renderTask(b.dataset.t); });
let CUR = TASKS[0];
$("cumSeg").addEventListener("click", e => { const b = e.target.closest("button[data-cum]"); if (!b) return; CUM = b.dataset.cum === "1"; $("cumSeg").querySelectorAll("button").forEach(x => x.setAttribute("aria-pressed", x === b)); renderTask(CUR); });
renderTask(TASKS[0]);

/* paths */
(() => {
  const row = (a, b, note) => `<div class="path"><span>${esc(a)}</span><span>${esc(b)}</span><button type="button" data-copy="${esc(b)}">Copy</button>${note ? `<span class="note">${note}</span>` : ""}</div>`;
  let h = `<details open><summary>Shared</summary>` + [
    row("Comparison data (this page)", ROOT + "analysis/compare/data.json"),
    row("Extraction script", ROOT + "analysis/compare/extract.py"),
    row("Page template", ROOT + "analysis/compare/template.html"),
    row("Condition prompt: c1", ROOT + "slop-code-bench/configs/prompts/parnas/c1_default.jinja", "metric_transform_lang ran this condition as c1_planning"),
    row("Condition prompt: c2", ROOT + "slop-code-bench/configs/prompts/parnas/c2_modular.jinja"),
    row("Condition prompt: c3", ROOT + "slop-code-bench/configs/prompts/parnas/c3_parnas.jinja"),
    row("Continuation prompt", ROOT + "slop-code-bench/configs/prompts/parnas/", "the <code>{% else %}</code> branch of each .jinja; identical text in all three"),
    row("Isolation checker", ROOT + "check_cell.py"),
    row("Failure summariser", ROOT + "failure_summary.py"),
    row("Cell runner / resume", ROOT + "run_cell.sh · resume_cell.sh"),
    row("Reference check scripts", ROOT + "refcheck.sh · refcheck_split.sh"),
    row("Harness verifier", ROOT + "verify_setup.sh"),
    row("Technique counts (regex)", ROOT + "analysis/qual/techniques.py", "techniques.csv; hand-check in techniques_validation.md"),
  ].join("") + `</details>`;
  for (const t of TASKS) {
    const T = DATA.tasks[t]; const sp = ROOT + T.spec_dir; const n = T.n_ck;
    const r = [
      row("Benchmark spec", sp + "/checkpoint_N.md", `N = 1–${n}`),
      row("Hidden tests", sp + "/tests/", "test_checkpoint_N.py, conftest.py and helpers; never shown to the agent"),
      row("Test fixtures", sp + "/tests/conftest.py"),
      row("Reference solution", sp + "/solutions/"),
      row("Problem config", sp + "/config.yaml"),
      row("Reference check", ROOT + T.refcheck, "checkpoint_N.json per checkpoint"),
    ];
    if (T.refcheck_split) r.push(row("Reference check, split into files", ROOT + T.refcheck_split));
    for (const C of cells(t)) {
      const run = ROOT + C.run_dir, P = `${run}/${t}`;
      r.push(row(`${C.name}: run directory`, run));
      r.push(row(`${C.name}: rendered prompts`, `${P}/checkpoint_N/prompt.txt`, "exact text the agent received"));
      r.push(row(`${C.name}: ck1 prompt`, ROOT + C.prompt_ckpt1));
      r.push(row(`${C.name}: transcripts`, `${P}/checkpoint_N/agent/stdout.jsonl`));
      r.push(row(`${C.name}: code snapshots`, `${P}/checkpoint_N/snapshot/`));
      r.push(row(`${C.name}: test reports`, `${P}/checkpoint_N/evaluation/report.json`));
      r.push(row(`${C.name}: results`, `${run}/checkpoint_results.jsonl`));
      r.push(row(`${C.name}: failure summary`, `${run}/failure_summary.md`));
      r.push(row(`${C.name}: isolation check`, `${run}/check_cell.txt`));
      r.push(row(`${C.name}: reset logs`, `${P}/parnas_reset_checkpoint_N.json`, "container respawn and doc deletion per checkpoint"));
      for (const l of C.resume_logs || []) r.push(row(`${C.name}: resume log`, ROOT + l));
      if (C.invalid_attempt) r.push(row(`${C.name}: invalid attempt kept`, ROOT + C.invalid_attempt));
    }
    h += `<details><summary class="mono">${t}</summary>${r.join("")}</details>`;
  }
  $("pathList").innerHTML = h;
  $("pathList").addEventListener("click", async e => {
    const b = e.target.closest("button[data-copy]"); if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = "Copied"; }
    catch { const s = b.previousElementSibling; const r = document.createRange(); r.selectNodeContents(s); getSelection().removeAllRanges(); getSelection().addRange(r); b.textContent = "Selected"; }
    setTimeout(() => b.textContent = "Copy", 1500);
  });
})();
