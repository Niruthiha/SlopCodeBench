+    write(project / "appctl.yml", ALIASES)
+    code, out, _ = call("@beta", "cli", "info", "--format=json", root=root, cwd=project)
+    assert json.loads(out)["path"] == str(project / "relative" / "beta")
+
+
+def test_group_runs_each_member_once_in_order(home):
+    root, project = home
+    write(project / "appctl.yml", ALIASES)
