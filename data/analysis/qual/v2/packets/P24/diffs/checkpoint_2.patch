+    write(project / "appctl.yml", '"@b": {url: b}\n"@A": {url: a}\n"@c": {url: c}\n')
+    code, out, _ = call("@all", "cli", "info", "--format=json", root=root, cwd=project)
+    assert [l for l in out.splitlines() if l.startswith("@")] == ["@A", "@b", "@c"]
