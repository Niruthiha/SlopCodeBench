+def dump_records(records):
+    """Serialise a list of flat mappings as a block-style YAML document."""
+    if _yaml is not None:
+        return _yaml.safe_dump(list(records), default_flow_style=False,
+                               sort_keys=False, explicit_start=True,
+                               allow_unicode=True).rstrip("\n")
+    lines = ["---"]
+    for record in records:
+        for index, (key, value) in enumerate(record.items()):
+            lead = "- " if index == 0 else "  "
+            lines.append(f"{lead}{key}: {json.dumps(value)}")
+    return "\n".join(lines) if records else "--- []"
 
 
