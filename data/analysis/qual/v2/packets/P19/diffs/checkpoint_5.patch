+def expr_text(expr):
+    """Compact source-like rendering of an expression (used in metadata)."""
+    if isinstance(expr, Literal):
+        if isinstance(expr.value, bool):
+            return "true" if expr.value else "false"
+        if isinstance(expr.value, str):
+            return '"' + expr.value + '"'
+        return repr(expr.value)
+    if isinstance(expr, ColumnRef):
+        return expr.name if expr.qualifier is None else f"{expr.qualifier}.{expr.name}"
+    if isinstance(expr, Unary):
+        return expr.op + _operand_text(expr.operand)
+    if isinstance(expr, Binary):
+        sep = "" if expr.op == "==" else " "
+        return f"{_operand_text(expr.left)}{sep}{expr.op}{sep}{_operand_text(expr.right)}"
+    if isinstance(expr, InExpr):
+        return f"{_operand_text(expr.needle)} in {_operand_text(expr.haystack)}"
+    if isinstance(expr, Cast):
+        return f"cast({expr_text(expr.operand)} as {expr.target})"
+    if isinstance(expr, Call):
+        return f"{expr.name}({', '.join(expr_text(a) for a in expr.args)})"
+    return "?"
+
+
+def _operand_text(expr):
+    text = expr_text(expr)
+    return f"({text})" if isinstance(expr, (Binary, InExpr)) else text

