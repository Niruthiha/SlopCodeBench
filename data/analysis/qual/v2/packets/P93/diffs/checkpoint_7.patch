+                                ["up", "-d", "--no-deps"] + self.running)
+
+    def revert_containers(self):
+        if self.running:
+            self.restore()
+            compose_run_checked(self.project_dir, self.files,
+                                ["up", "-d", "--no-deps"] + self.running)
+
+    def cleanup(self):
