+    result = docker_run(["info", "--format", "{{.DockerRootDir}}"])
+    lines = result.stdout.strip().splitlines() if result.return_code == 0 else []
+    root = lines[0].strip() if lines else ""
+    return root if os.path.isabs(root) else None
