+# --------------------------------------------------------------------------- run metadata
+
+BAD_RECORD_KINDS = (PARSE_TYPE_MISMATCH, TIMESTAMP_PARSE_ERROR, RUNTIME_ERROR, TYPE_ERROR, MISSING_REQUIRED_FIELD,
+                    PARQUET_TYPE_MISMATCH)
+
+
