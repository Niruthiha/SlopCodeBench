+        if kind == TS:
+            raw = col.cast(pa.int64()).to_pylist()
+            factor = {"s": 1_000_000, "ms": 1000, "us": 1, "ns": None}[t.unit]
+            items = []
+            for v in raw:
+                if v is None:
+                    items.append(None)
+                    continue
+                us = v // 1000 if factor is None else v * factor
+                try:
+                    if t.tz is not None:
+                        items.append(EPOCH + timedelta(microseconds=us))
+                    else:
