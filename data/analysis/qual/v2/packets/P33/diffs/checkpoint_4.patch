+# --------------------------------------------------------------------------- ingest config
+
+SOURCE_KEYS = ("name", "inputs", "recursive", "format", "schema", "precedence", "tz", "nulls", "mapping", "required")
+MAPPING_KEYS = ("drop", "rename", "cast", "defaults")
+YAML_NULL_MARKERS = ("null", "NULL", "Null", "~")
