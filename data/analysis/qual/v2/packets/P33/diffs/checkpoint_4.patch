+class SourceConfig:
+    def __init__(self, name):
+        self.name = name
+        self.inputs = []
+        self.recursive = None
+        self.format = None
+        self.schema = None
+        self.precedence = 0
+        self.tz = None
+        self.nulls = None
+        self.drop = []
+        self.rename = {}
+        self.cast = {}
+        self.defaults = {}
+        self.required = []
