+def load_namespaces(path):
+    try:
+        with open(path, 'rb') as f:
+            data = json.loads(f.read().decode('utf-8'))
+    except OSError as e:
+        raise SithError('cannot read namespaces file: %s' % e)
+    except ValueError as e:
+        raise SithError('invalid namespaces file: %s' % e)
+    if not isinstance(data, list) or not all(isinstance(ns, dict) for ns in data):
+        raise SithError('invalid namespaces file: expected a JSON array of objects')
+    for ns in data:
+        for k, v in ns.items():
+            if not isinstance(v, dict):
