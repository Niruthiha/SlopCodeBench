+def load_project_config(root):
+    """Normalized project configuration for ``root`` (defaults if absent)."""
+    cfg = dict(PROJECT_DEFAULTS)
+    data = read_project_config(root) if root else None
+    if data:
+        env = data.get('environment_path', '')
+        cfg['environment_path'] = env if isinstance(env, str) else ''
+        cfg['sys_path'] = _path_list(data.get('sys_path'))
+        cfg['added_sys_path'] = _path_list(data.get('added_sys_path'))
+        for k in SETTING_DEFAULTS:
+            if k in data:
+                try:
+                    cfg[k] = parse_bool(data[k])
+                except SithError:
+                    raise SithError('invalid value for %s in project configuration' % k)
+    return cfg
