+def context(path, line, col, project=None):
+    text = read_source(path)
+    lines = text.split('\n')
+    _check_pos(lines, line, col)
+    project_root(path, project)
+    tree = parse_source(text)
+    info = ModuleInfo(os.path.abspath(path), tree, '__main__', text)
