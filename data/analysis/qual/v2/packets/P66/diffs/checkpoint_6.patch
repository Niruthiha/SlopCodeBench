+def read_project_config(root):
+    """The raw project configuration stored under ``root`` (None if absent)."""
+    p = config_path(root)
+    if not os.path.isfile(p):
+        return None
+    try:
+        with open(p, 'rb') as f:
+            data = json.loads(f.read().decode('utf-8'))
+    except (OSError, ValueError) as e:
+        raise SithError('invalid project configuration %s: %s' % (p, e))
+    if not isinstance(data, dict):
