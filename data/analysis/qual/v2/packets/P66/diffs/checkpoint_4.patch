+    def pick_overload(self, variants, f, args, depth):
+        """The first overload accepting the call ``args`` (all if undecidable)."""
+        if args is None:
+            return variants
+        for node, vsc in variants:
+            try:
+                ok = self._overload_matches(node, vsc, f, args, depth)
+            except RecursionError:
+                ok = False
+            if ok:
+                return [(node, vsc)]
