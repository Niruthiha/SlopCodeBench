+def _open_brackets(text, end):
+    """Unclosed brackets [(index, char)] before ``end``, and whether ``end``
+    lies inside a comment."""
+    stack = []
+    i = 0
+    line_start = True
+    while i < end:
+        c = text[i]
+        if line_start:
+            line_start = False
+            if stack and _DEF_LINE_RE.match(text, i):
+                stack = []
+        if c == '\n':
+            line_start = True
+        elif c == '#':
+            j = text.find('\n', i)
+            if j < 0 or j >= end:
+                return stack, True
+            i = j
+            continue
+        elif c in '"\'':
+            i = _skip_string(text, i, end)
+            continue
+        elif c in '([{':
+            stack.append((i, c))
+        elif c in ')]}':
+            want = {')': '(', ']': '[', '}': '{'}[c]
+            for k in range(len(stack) - 1, -1, -1):
+                if stack[k][1] == want:
+                    del stack[k:]
+                    break
+        i += 1
+    return stack, False
