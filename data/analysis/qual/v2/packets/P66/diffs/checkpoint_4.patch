+def _skip_string(text, i, n):
+    """``text[i]`` starts a string; return the index after it (or ``n``)."""
+    c = text[i]
+    q = c * 3 if text.startswith(c * 3, i) else c
+    j = i + len(q)
+    while j < n:
+        ch = text[j]
+        if ch == '\\':
+            j += 2
+            continue
+        if len(q) == 1 and ch == '\n':
+            return j
+        if text.startswith(q, j):
+            return j + len(q)
+        j += 1
+    return n + 1
