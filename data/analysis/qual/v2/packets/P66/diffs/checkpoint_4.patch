+def _call_args(text, start, cursor):
+    """Split the arguments of a call opened at ``start - 1``.
+
+    Returns (previous_args, current_arg) as source strings.
+    """
+    depth = 0
+    seg = start
+    prev = []
+    end = len(text)
+    i = start
+    n = len(text)
+    while i < n:
+        c = text[i]
+        if c == '#':
+            j = text.find('\n', i)
+            if j < 0:
+                break
+            i = j
+            continue
+        if c in '"\'':
+            i = _skip_string(text, i, n)
+            continue
+        if c == '\n' and i >= cursor:
+            end = i
+            break
+        if c in '([{':
+            depth += 1
+        elif c in ')]}':
+            if depth == 0:
+                end = i
+                break
+            depth -= 1
+        elif c == ',' and depth == 0:
+            if i < cursor:
+                prev.append(text[seg:i])
+                seg = i + 1
+            else:
+                end = i
+                break
+        i += 1
+    if end < cursor:
+        end = cursor
+    return prev, text[seg:end]
