+    def loop(self, s, st, test=None):
+        """Return (entry_state, normal_exit_state, breaks) for a loop."""
+        is_for = isinstance(s, (ast.For, ast.AsyncFor))
+        first = self.hdr(s, st)
+        if test is not None:
+            first = self.narrow(first, test, True)
