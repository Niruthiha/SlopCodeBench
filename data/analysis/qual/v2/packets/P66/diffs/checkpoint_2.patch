+            base = os.path.basename(path)
+            if base == '__init__.py':
+                return os.path.basename(os.path.dirname(path))
+            return base[:-3] if base.endswith('.py') else base
+        if rp.endswith('.py'):
+            rp = rp[:-3]
+        parts = rp.split(os.sep)
+        if parts[-1] == '__init__' and len(parts) > 1:
+            parts.pop()
+        return '.'.join(parts)
+
+    def qual(self, sc, name):
