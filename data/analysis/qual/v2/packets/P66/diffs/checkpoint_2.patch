+def _decorator_names(node):
+    out = set()
+    for d in getattr(node, 'decorator_list', ()):
+        if isinstance(d, ast.Call):
+            d = d.func
+        if isinstance(d, ast.Name):
+            out.add(d.id)
+        elif isinstance(d, ast.Attribute):
+            out.add(d.attr)
+    return out
