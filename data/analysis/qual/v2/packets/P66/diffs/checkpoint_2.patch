+def _st_union(states):
+    states = [s for s in states if s is not None]
+    if not states:
+        return None
+    if len(states) == 1:
+        return states[0]
+    ents = []
+    seen = set()
+    for s in states:
+        for e in s:
+            k = (id(e[1]),) + tuple(id(op) for op in e[2])
+            if k not in seen:
+                seen.add(k)
+                ents.append(e)
+    return tuple(ents)
