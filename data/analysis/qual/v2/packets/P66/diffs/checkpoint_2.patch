+    def rel(self, path):
+        ap = os.path.abspath(path)
+        try:
+            rp = os.path.relpath(ap, self.root)
+        except ValueError:
+            return ap
+        if rp == '..' or rp.startswith('..' + os.sep):
+            return ap
+        return rp
