+def _dotted_ok(parts):
+    """True if ``parts`` alternate identifier, '.', identifier, ..."""
+    for k, p in enumerate(parts):
+        if k % 2:
+            if p != '.':
+                return False
+        elif not p.isidentifier() or keyword.iskeyword(p):
+            return False
+    return len(parts) % 2 == 1
+
