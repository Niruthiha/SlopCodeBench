         return command_str, env_overrides
 
     def _build_cli_args(
@@ -1052,5 +1064,26 @@ class ClaudeCodeAgent(Agent):
         self.log.debug("agent.claude_code.cleanup")
 
 
+# --- Parnas pilot P1: read-only credential mount -----------------------------------
+_CREDS_CONTAINER_PATH = "/creds/credentials.json"
+
+
+def _ro_creds_mode() -> bool:
+    return bool(os.environ.get("SCB_CLAUDE_CREDS"))
+
+
+def _wrap_creds(command: str) -> str:
+    """Copy the read-only mounted credential into HOME (the CLI must be able to refresh
+    it), run the command, and delete the copy on exit. The host never reads the file."""
+    if not _ro_creds_mode():
+        return command
+    dst = '"$HOME/.claude/.credentials.json"'
+    return (
+        # one trap for both jobs: a second `trap ... EXIT` would replace the trace-cleanup trap
+        f"trap 'rm -f {dst}; chmod -R u+rwX \"$HOME/.claude\" 2>/dev/null || true' EXIT; "
+        f"cp {_CREDS_CONTAINER_PATH} {dst} && chmod 600 {dst} && {command}"
+    )
+
+
 # Register this agent type with the agent registry
 register_agent("claude_code", ClaudeCodeAgent)
