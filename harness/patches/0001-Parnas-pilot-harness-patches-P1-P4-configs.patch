     report = evaluate_checkpoint(
         submission_path=snapshot_dir,
         problem=problem,
@@ -660,6 +676,51 @@ class AgentRunner:
             checkpoint=checkpoint.name,
         )
         self.agent.finish_checkpoint(reset_context=True)
+        self._parnas_reset(checkpoint)
+
+    def _parnas_reset(self, checkpoint: CheckpointConfig) -> None:
+        """Parnas pilot P3 (fresh extender): before every checkpoint after the first,
+        delete DESIGN.md / CLAUDE.md / AGENTS.md / .claude/ from the workspace and empty
+        the agent's ~/.claude except settings.json. Code is kept. Listings of both folders
+        before and after are written to the run output (evidence, not just transcripts)."""
+        if os.environ.get("SCB_PARNAS_RESET", "1") != "1":
+            return
+        ws = Path(self.session.working_dir)
+        home = getattr(self.agent, "_trace_dir", None)
+
+        def listing(root: Path | None) -> list[str]:
+            if root is None or not root.exists():
+                return []
+            out = []
+            for dp, dns, fns in os.walk(root):
+                dns[:] = [d for d in dns if d not in (".venv", "__pycache__", "node_modules")]
+                for n in fns:
+                    out.append(str((Path(dp) / n).relative_to(root)))
+            return sorted(out)
+
+        before = {"workspace": listing(ws), "claude_home": listing(home)}
+        removed: list[str] = []
+        for name in ("DESIGN.md", "CLAUDE.md", "AGENTS.md", "CLAUDE.local.md"):
+            for p in ws.rglob(name):
+                if ".venv" in p.parts:
+                    continue
+                p.unlink()
+                removed.append(str(p.relative_to(ws)))
+        for p in list(ws.rglob(".claude")):
+            if p.is_dir() and ".venv" not in p.parts:
+                shutil.rmtree(p)
+                removed.append(str(p.relative_to(ws)) + "/")
+        if home is not None and Path(home).exists():
+            for p in Path(home).iterdir():
+                if p.name != "settings.json":
+                    shutil.rmtree(p) if p.is_dir() else p.unlink()
+                    removed.append("~/.claude/" + p.name)
+        after = {"workspace": listing(ws), "claude_home": listing(home)}
+        record = {"checkpoint": checkpoint.name, "removed": removed,
+                  "before": before, "after": after}
+        (self.output_path / f"parnas_reset_{checkpoint.name}.json").write_text(
+            json.dumps(record, indent=2))
+        logger.info("parnas.reset_done", checkpoint=checkpoint.name, removed=removed)
 
     def finish(self) -> dict[str, Any]:
         """Cleanup agent, stop monitoring, save final results."""
