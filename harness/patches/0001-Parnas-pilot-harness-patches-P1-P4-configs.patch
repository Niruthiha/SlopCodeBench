@@ -0,0 +1,31 @@
+# Agent environment: internal network, all traffic through the allowlist proxy scb-egress-agent
+# (Anthropic API + PyPI only). GitHub, the problem repo and everything else are refused.
+type: docker
+name: python3.12
+docker:
+  image: ghcr.io/astral-sh/uv:python3.12-trixie-slim
+  workdir: /workspace
+  mount_workspace: true
+  network: scb-cellnet
+environment:
+  env:
+    UV_CACHE_DIR: /tmp/uv-cache
+    PIP_CACHE_DIR: /tmp/pip-cache-dir
+    PIP_CONFIG_FILE: /tmp/pip-conf
+    HTTPS_PROXY: http://scb-egress-agent:8888
+    HTTP_PROXY: http://scb-egress-agent:8888
+    https_proxy: http://scb-egress-agent:8888
+    http_proxy: http://scb-egress-agent:8888
+    NO_PROXY: localhost,127.0.0.1
+    no_proxy: localhost,127.0.0.1
+setup:
+  eval_commands:
+    - uv init
+    - uv add -r requirements.txt
+  resume_commands:
+    - python -m venv .venv || true
+    - .venv/bin/pip install -r requirements.txt 2>/dev/null || true
+commands:
+  entry_file: "{entry_file}.py"
+  command: uv run
+  agent_command: "python"
